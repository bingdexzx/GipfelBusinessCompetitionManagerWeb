[Unit]
Description=Gipfel Log Viewer (daphne ASGI, internal 127.0.0.1:8121)
After=network.target remote-fs.target nss-lookup.target
Wants=network.target

[Service]
Type=simple
# 建议使用专用用户：sudo useradd -r -s /usr/sbin/nologin gipfel
User=gipfel
Group=gipfel

# 工作目录 = 日志查看器项目根目录（manage.py 所在目录）
WorkingDirectory=__INSTALL_DIR__/backend/logviewer
Environment="PATH=__INSTALL_DIR__/backend/.venv/bin"
# 复用主后端 .env：含 LOGVIEWER_SECRET_KEY（防直连令牌校验密钥）、LOG_DIR、LOG_VIEWER_PORT 等
EnvironmentFile=-__INSTALL_DIR__/backend/.env

# 启动 daphne：仅绑定 127.0.0.1（不暴露公网），由 nginx 整站代理到外部
# 注意：日志查看器 STATIC_URL 为 /static/，故 nginx 必须整站代理（不能走带前缀的路径代理）
# 内网端口用 8121，公网 8120 由 nginx 监听并反代（若也用 8120 会与 nginx 抢端口导致 nginx 起不来）
ExecStart=__INSTALL_DIR__/backend/.venv/bin/daphne \
    -b 127.0.0.1 \
    -p 8121 \
    --access-log /var/log/gipfel/logviewer.access.log \
    --proxy-headers \
    logviewer.asgi:application

# 运行目录（.sock + .pid）与日志目录；systemd 在启动前自动创建
RuntimeDirectory=gipfel
RuntimeDirectoryMode=0755
LogsDirectory=gipfel
LogsDirectoryMode=0755

Restart=always
RestartSec=3s
KillSignal=SIGTERM
TimeoutStopSec=30

# 沙箱加固（M9）：最小权限 + 文件系统只读 + 仅开放必要可写路径
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# 与 gipfel.service 保持一致：AF_UNIX 必须保留，防止未来增加 Unix socket 监听时
# 被 RestrictAddressFamilies 以 EAFNOSUPPORT（Errno 97）拒绝导致服务无法启动。
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadWritePaths=__INSTALL_DIR__/backend/uploads __INSTALL_DIR__/backend/logs __INSTALL_DIR__/backend/db.sqlite3 /run/gipfel /var/log/gipfel

[Install]
WantedBy=multi-user.target
