# ============================================================
# Gipfel 商赛系统 — Django 服务端环境变量配置
# 复制本文件为 .env 并按需修改：copy .env.example .env
# ============================================================

# 服务端监听端口（默认 8000）
# 单一真源：① 用 `python manage.py rundaphne` 启动时会按此端口绑定 daphne；
#          ② 经 /api/version 下发，前端「系统设置 → 后端管理」跳转按钮据此拼后台地址。
# 改端口只需改这里并重启，无需动前端代码。
PORT=8000

# 【必填】JWT 签名密钥 —— 未配置时服务端直接拒绝启动（fail-fast）
# 留空即可：deploy-linux.sh 首次部署会自动生成强随机值写入 .env。
# 本地手动开发请自行填入：openssl rand -hex 32（切勿使用下方被注释的弱值）
JWT_SECRET=""

# 默认超级管理员（首次 migrate 自动写入；业务超管 + Django 后台 /admin 超管共用同一凭据）
# 仅当库中尚无该用户名时创建；已存在则跳过，不覆盖。
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="admin23"

# JWT 有效期（默认 24h，支持 ms 库格式：1h / 7d / 30m）
JWT_EXPIRES_IN="24h"

# JWT 签发者声明（默认 gipfel-competition）
JWT_ISSUER="gipfel-competition"

# JWT 受众声明（默认 gipfel-competition-client）
JWT_AUDIENCE="gipfel-competition-client"

# 日志级别：ERROR / WARNING / INFO / DEBUG（默认 INFO）
LOG_LEVEL="INFO"

# 日志文件输出目录（相对 backend/，默认 ./logs）
LOG_DIR="./logs"

# CORS 允许的来源（可选）
# 未设置：仅允许本地/私网来源（localhost、RFC1918、file://、app://）反射并带凭据
# 设为具体域名（逗号分隔）：严格白名单，且该来源会带凭据（Access-Control-Allow-Credentials）
# 设为 *：同「未设置」行为（不放行公网）
# CORS_ORIGIN="https://your-domain.com"

# Django ALLOWED_HOSTS（Host 头白名单，逗号分隔）
# 【生产必填】设置为公网域名或服务器 IP，例如 "example.com,www.example.com,1.2.3.4"
# 未设置时仅回环地址（127.0.0.1/localhost）可达，公网访问会被拒（400），并消除 Host 投毒风险
DJANGO_ALLOWED_HOSTS="127.0.0.1,localhost,::1"

# 上传文件根目录（默认 ./uploads）
UPLOAD_DIR="./uploads"

# 日志查看器服务端口（独立服务，默认 8120；启动脚本 scripts/start_logviewer.py 读取）
LOG_VIEWER_PORT=8120

# 日志查看器「防直连」令牌共享密钥（与主后端共用同一 .env；主后端用它签发一次性令牌，
# 日志查看器用它校验。缺失时回退到 JWT_SECRET）。留空即可：deploy-linux.sh 首次部署会
# 自动生成强随机值（无论 .env.example 是否带默认值都会覆盖）。主后端与日志查看器必须读到
# 同一个值，否则令牌校验失败（403）。切勿使用弱默认值。
LOGVIEWER_SECRET_KEY=""

# 日志查看器「防直连」直连跳转目标（可选）：直接输入网址无有效令牌时 302 跳转回的前端主站地址。
# 未设置：按请求 Host 自动推导（日志查看器挂在 log.<域名> 或 :8120，前端主站在 <域名> 或 :80）。
# 例：LOGVIEWER_FRONTEND_URL="https://your-domain.com/"
