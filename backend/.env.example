# ============================================================
# Gipfel 商赛系统 — Django 服务端环境变量配置
# 复制本文件为 .env 并按需修改：copy .env.example .env
# ============================================================

# 服务端监听端口（默认 8000）
# 单一真源：① 用 `python manage.py rundaphne` 启动时会按此端口绑定 daphne；
#          ② 经 /api/version 下发，前端「系统设置 → 后端管理」跳转按钮据此拼后台地址。
# 改端口只需改这里并重启，无需动前端代码。
PORT=8000

# 【必填】JWT 签名密钥 —— 未配置时服务端直接拒绝启动
# 生产环境必须改为强随机值，如：openssl rand -hex 32
JWT_SECRET="your-dev-secret-change-in-production"

# 默认超级管理员（首次 migrate 自动写入；业务超管 + Django 后台 /admin 超管共用同一凭据）
# 仅当库中尚无该用户名时创建；已存在则跳过，不覆盖。
# SEED_ADMIN_USERNAME="admin"
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="your-strong-password"

# JWT 有效期（默认 24h，支持 ms 库格式：1h / 7d / 30m）
JWT_EXPIRES_IN="24h"

# JWT 签发者声明（默认 gipfel-competition）
JWT_ISSUER="gipfel-competition"

# JWT 受众声明（默认 gipfel-competition-client）
JWT_AUDIENCE="gipfel-competition-client"

# 日志级别：ERROR / WARNING / INFO / DEBUG（默认 INFO）
LOG_LEVEL="INFO"

# 日志文件输出目录（相对 backend/，默认 ./logs）
LOG_DIR="./logs"

# CORS 允许的来源（可选）
# 未设置：仅允许本地/私网来源（localhost、RFC1918、file://、app://）反射并带凭据
# 设为具体域名（逗号分隔）：严格白名单
# 设为 *：同「未设置」行为（不放行公网）
# CORS_ORIGIN="https://your-domain.com"

# 上传文件根目录（默认 ./uploads）
UPLOAD_DIR="./uploads"

# 日志查看器服务端口（独立服务，默认 8120；启动脚本 scripts/start_logviewer.py 读取）
LOG_VIEWER_PORT=8120
