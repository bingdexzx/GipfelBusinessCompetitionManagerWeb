# ===== Python / Django =====
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/
backend/.deps/
*.sqlite3
db.sqlite3

# ===== Django 运行时目录（保留空目录，忽略生成内容）=====
backend/uploads/
!backend/uploads/.gitkeep
backend/logs/
!backend/logs/.gitkeep
backend/staticfiles/

# ===== 密钥 / 环境配置 =====
.env
.env.*
!.env.example

# ===== Node / Vue (前端) =====
node_modules/
frontend/dist/
dist/
# 生产构建产物（deploy-linux.sh / update-from-github.sh 复制到仓库根的 frontend-dist/）
frontend-dist/
.vite/
*.local
# vite 加载 vite.config.ts 时生成的临时编译文件，构建中断时会残留
vite.config.ts.timestamp-*.mjs
vite.config.js.timestamp-*.mjs

# ===== 日志（保留项目根 logs/ 空目录）=====
logs/
!logs/.gitkeep
*.log

# ===== OS / 编辑器 =====
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.workbuddy/
